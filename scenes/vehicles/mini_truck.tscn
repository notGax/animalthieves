[sub_resource type="CylinderMesh" id="tire_mesh"]
top_radius = 0.42
bottom_radius = 0.42
height = 0.3

[sub_resource type="CylinderMesh" id="hub_mesh"]
top_radius = 0.189
bottom_radius = 0.189
height = 0.312

[node name="MiniTruck" type="Node3D"]

[node name="Flatbed" type="MeshInstance3D" parent="."]
position = Vector3(0, -0.42, 0.1)
mesh = SubResource("flatbed_mesh")
material_override = SubResource("worn")

