class_name VehicleMaterials
extends RefCounted

## Shared stylized material set for vehicles, cropped from one atlas texture
## (assets/vehicles/vehicle_atlas.png, generated by tools/build_vehicle_atlas.py).
## Every material is cached and shared between the three vehicle rigs, so the
## whole fleet costs a handful of material instances and one texture upload.

const ATLAS_PATH := "res://assets/vehicles/vehicle_atlas.png"
const TILE := 0.25

static var _atlas: Texture2D
static var _cache: Dictionary = {}

# Atlas tile coordinates (col,row) - keep in sync with tools/build_vehicle_atlas.py.
const TILE_CART := Vector2i(0, 0)
const TILE_CART_WORN := Vector2i(1, 0)
const TILE_TRUCK := Vector2i(2, 0)
const TILE_TRUCK_WORN := Vector2i(3, 0)
const TILE_RACE := Vector2i(0, 1)
const TILE_RACE_WORN := Vector2i(1, 1)
const TILE_DARK := Vector2i(2, 1)
const TILE_CREAM := Vector2i(3, 1)
const TILE_METAL := Vector2i(0, 2)
const TILE_BRASS := Vector2i(1, 2)
const TILE_RUBBER := Vector2i(2, 2)
const TILE_GLASS := Vector2i(3, 2)
const TILE_GRIME := Vector2i(0, 3)
const TILE_LENS := Vector2i(1, 3)
const TILE_HUB := Vector2i(2, 3)
const TILE_HAZARD := Vector2i(3, 3)

const PAINT_TILES: Dictionary = {
	"cart": [TILE_CART, TILE_CART_WORN],
	"truck": [TILE_TRUCK, TILE_TRUCK_WORN],
	"racecar": [TILE_RACE, TILE_RACE_WORN],
}


static func _texture() -> Texture2D:
	if _atlas == null:
		_atlas = load(ATLAS_PATH)
	return _atlas


static func _crop(tile: Vector2i) -> Dictionary:
	return {
		"offset": Vector3(float(tile.x) * TILE, float(tile.y) * TILE, 0.0),
		"scale": Vector3(TILE, TILE, 1.0),
	}


static func _material(key: String, tile: Vector2i, roughness: float, metallic: float,
		emission: Color = Color.BLACK, emission_energy: float = 0.0,
		alpha: float = 1.0) -> StandardMaterial3D:
	if _cache.has(key):
		return _cache[key]
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = _texture()
	var crop := _crop(tile)
	mat.uv1_offset = crop.offset
	mat.uv1_scale = crop.scale
	mat.albedo_color = Color(1.0, 1.0, 1.0, alpha)
	mat.roughness = roughness
	mat.metallic = metallic
	if emission_energy > 0.0:
		mat.emission_enabled = true
		mat.emission = emission
		mat.emission_energy_multiplier = emission_energy
	if alpha < 1.0:
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	# Vehicles are small and fast; cheap but not free shadows.
	_cache[key] = mat
	return mat


static func paint(kind: String) -> StandardMaterial3D:
	var tiles: Array = PAINT_TILES.get(kind, PAINT_TILES["cart"])
	return _material("paint_" + kind, tiles[0], 0.55, 0.1)


## Slightly rougher variant for panels that read as scratched/used.
static func paint_worn(kind: String) -> StandardMaterial3D:
	var tiles: Array = PAINT_TILES.get(kind, PAINT_TILES["cart"])
	return _material("paint_worn_" + kind, tiles[1], 0.7, 0.05)


static func dark() -> StandardMaterial3D:
	return _material("dark", TILE_DARK, 0.85, 0.1)


static func cream() -> StandardMaterial3D:
	return _material("cream", TILE_CREAM, 0.75, 0.0)


static func metal() -> StandardMaterial3D:
	return _material("metal", TILE_METAL, 0.45, 0.85)


static func brass() -> StandardMaterial3D:
	return _material("brass", TILE_BRASS, 0.35, 0.9)


static func rubber() -> StandardMaterial3D:
	return _material("rubber", TILE_RUBBER, 0.95, 0.0)


static func glass() -> StandardMaterial3D:
	return _material("glass", TILE_GLASS, 0.12, 0.3, Color.BLACK, 0.0, 0.55)


static func grime() -> StandardMaterial3D:
	return _material("grime", TILE_GRIME, 0.9, 0.0)


static func lens() -> StandardMaterial3D:
	return _material("lens", TILE_LENS, 0.3, 0.0, Color(1.0, 0.9, 0.62), 2.4)


static func hub() -> StandardMaterial3D:
	return _material("hub", TILE_HUB, 0.4, 0.8)


static func hazard() -> StandardMaterial3D:
	return _material("hazard", TILE_HAZARD, 0.7, 0.0)